# Koha–DSpace Evidence-Grounded AI Discovery
# Example configuration only.
#
# NEVER put real API keys or passwords in this file when committing to GitHub.
# Copy this file to a protected environment file on the deployment host
# and replace the placeholder credential values there.

# -----------------------------
# Qdrant
# -----------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=replace_with_strong_qdrant_api_key
KDAI_QDRANT_COLLECTION=kdai_evidence_v1

# -----------------------------
# Embeddings
# -----------------------------
KDAI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# -----------------------------
# OpenAI provider
# -----------------------------
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-6-luna
KDAI_OPENAI_MAX_OUTPUT_TOKENS=600

# -----------------------------
# Ollama / local Llama provider
# -----------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_THREAD=4
KDAI_OLLAMA_MAX_OUTPUT_TOKENS=120

# -----------------------------
# Retrieval / evidence controls
# -----------------------------
KDAI_EVIDENCE_LIMIT=4
KDAI_EVIDENCE_TEXT_CHARS=500
KDAI_MAX_PER_DOCUMENT=2
KDAI_MIN_EVIDENCE_SCORE=0.58

# -----------------------------
# State / caching
# -----------------------------
KDAI_STATE_DIR=/var/lib/kdai-ai
KDAI_CACHE_TTL_SECONDS=86400

# -----------------------------
# Patron rate limits
# -----------------------------
KDAI_PER_IP_HOURLY_LIMIT=10
KDAI_GLOBAL_DAILY_LIMIT=100
